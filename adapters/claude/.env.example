# Copy this file to adapters/claude/.env for local overrides.
# The defaults below match the adapter's built-in settings.

EXECUTION_BASE_URL=http://localhost:5000
HTTP_TIMEOUT=30
SIMULATION_TIMEOUT=600
ENSURE_TIMEOUT=120
SERVER_SPAWN_TIMEOUT=20

# Leave unset to use the standard Debug build under this repository.
# Use forward slashes in a custom Windows path to avoid escape ambiguity.
# EXECUTION_EXE_PATH=C:/src/solidpilot/solidworks-execution/SolidworksExecution/bin/Debug/SolidworksExecution.exe
